{
  "defaults": {
    "benchmarks": ["nq", "triviaqa", "popqa", "hotpot", "2wiki", "musique", "bamboogle"],
    "num_workers": 128,
    "num_trials": 1,
    "sample_seed": 42,
    "compression_factor": 1.2,
    "resume": true
  },
  "groups": {
    "main": {
      "max_samples": 1000000000,
      "experiments": [
        {
          "id": "base_vl",
          "label": "Base VL",
          "model_path": "${BASE_VL_MODEL_PATH}"
        },
        {
          "id": "sft_only",
          "label": "SFT only",
          "model_path": "${SFT_MODEL_PATH}"
        },
        {
          "id": "sft_rl",
          "label": "SFT+RL",
          "model_path": "${RL_MODEL_PATH}"
        },
        {
          "id": "browseragent_v1",
          "label": "BrowserAgent-v1",
          "existing_result_dir": "${BROWSERAGENT_V1_RESULT_DIR}"
        },
        {
          "id": "agentocr",
          "label": "AgentOCR",
          "fixed_scores": {
            "nq": 43.1,
            "triviaqa": 61.0,
            "popqa": 45.4,
            "hotpot": 40.8,
            "2wiki": 38.3,
            "musique": 15.7,
            "bamboogle": 36.8
          }
        }
      ]
    },
    "rl_ablation": {
      "max_samples": 1000,
      "experiments": [
        {
          "id": "all_rewards",
          "label": "All Rewards",
          "model_path": "${RL_ALL_REWARDS_MODEL_PATH}"
        },
        {
          "id": "wo_dense_reward",
          "label": "w/o dense reward",
          "model_path": "${RL_WO_DENSE_MODEL_PATH}"
        },
        {
          "id": "wo_action_penalty",
          "label": "w/o action penalty",
          "model_path": "${RL_WO_ACTION_PENALTY_MODEL_PATH}"
        },
        {
          "id": "wo_format_reward",
          "label": "w/o format reward",
          "model_path": "${RL_WO_FORMAT_MODEL_PATH}"
        }
      ]
    },
    "compression_ablation": {
      "max_samples": 1000,
      "experiments": [
        {
          "id": "ratio_1_0",
          "label": "1.0",
          "model_path": "${COMPRESSION_MODEL_PATH}",
          "compression_factor": 1.0
        },
        {
          "id": "ratio_1_2",
          "label": "1.2",
          "model_path": "${COMPRESSION_MODEL_PATH}",
          "compression_factor": 1.2
        },
        {
          "id": "ratio_1_4",
          "label": "1.4",
          "model_path": "${COMPRESSION_MODEL_PATH}",
          "compression_factor": 1.4
        },
        {
          "id": "ratio_1_6",
          "label": "1.6",
          "model_path": "${COMPRESSION_MODEL_PATH}",
          "compression_factor": 1.6
        },
        {
          "id": "ratio_1_8",
          "label": "1.8",
          "model_path": "${COMPRESSION_MODEL_PATH}",
          "compression_factor": 1.8
        },
        {
          "id": "ratio_2_0",
          "label": "2.0",
          "model_path": "${COMPRESSION_MODEL_PATH}",
          "compression_factor": 2.0
        }
      ]
    }
  }
}
